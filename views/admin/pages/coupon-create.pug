extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  +alert_success("5000")

  h1.box-title Tạo mã giảm giá
  .section-8
    form#coupon-create-form
      .inner-group
        label(class="inner-label" for="name") Tên sự kiện *
        input(type="text" id="name" name="name")
      .inner-group
        label(class="inner-label" for="code") Mã giảm giá *
        input(type="text" id="code" name="code")


          //- +options(categoryList, 0)
      .inner-group
        label(class="inner-label" for="discountValue") % Giảm giá *
        input(type="number" id="discountValue" name="discountValue" min = "0")
      .inner-group
        label(class="inner-label" for="maxDiscountAmount") Giảm tối đa
        input(type="number" id="maxDiscountAmount" name="maxDiscountAmount" min = "0")
      .inner-group
        label(class="inner-label" for="quantity") Số lượng *
        input(type="number" id="quantity" name="quantity" min = "0")
      .inner-group
        label(class="inner-label" for="endDate") Ngày hết hạn *
        input(type="date" id="endDate" name="endDate")
      .inner-group
          label(class="inner-label" for="status") Trạng thái
          select(id="status" name="status")
            option(value="active") Hoạt động
            option(value="inactive") Tạm dừng

      
      .inner-button.inner-two-col
        button Tạo mới
    .inner-back
      a(href=`/${pathAdmin}/coupon/list`) Quay lại danh sách
